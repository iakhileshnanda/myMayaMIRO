# ================================
# Maya MIRO — Configuration
# ================================

# ---- LLM Provider (pick ONE, comment out the others) ----

# Option 1: NVIDIA NIM (free tier, rate-limited)
LLM_API_KEY=your_nvidia_nim_api_key_here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL_NAME=qwen/qwen3.5-397b-a17b

# Option 2: OpenRouter (many models, pay-per-token)
# LLM_API_KEY=sk-or-v1-your-openrouter-key
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL_NAME=qwen/qwen3-235b-a22b

# Option 3: Groq (fast, free tier available)
# LLM_API_KEY=gsk_your-groq-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL_NAME=llama-3.3-70b-versatile

# Option 4: Ollama (local, no API key needed)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL_NAME=qwen2.5:32b

# ---- Neo4j ----
NEO4J_URI=neo4j+ssc://
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ---- Embeddings (keep NVIDIA NIM even if LLM uses another provider) ----
EMBEDDING_MODEL=nvidia/nv-embed-v1
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_API_KEY=your_nvidia_nim_api_key_here

# ---- Rate Limit / Report Tuning (optional) ----
# Reduce these if you hit rate limits on free-tier APIs
# REPORT_AGENT_MAX_TOOL_CALLS=3
# REPORT_AGENT_MAX_REFLECTION_ROUNDS=1